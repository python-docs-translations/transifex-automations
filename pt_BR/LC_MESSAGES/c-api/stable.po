"0x30a0000  /* Py_PACK_VERSION(3.10) */\n"
"0x30b0000  /* Py_PACK_VERSION(3.11) */\n"
"0x30c0000  /* Py_PACK_VERSION(3.12) */\n"
"0x30d0000  /* Py_PACK_VERSION(3.13) */\n"
"0x30e0000  /* Py_PACK_VERSION(3.14) */\n"
"0x30f0000  /* Py_PACK_VERSION(3.15) */"
