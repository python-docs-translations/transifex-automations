msgstr "Опция"

#: ../../library/tkinter.ttk.rst:112 ../../library/tkinter.ttk.rst:147
#: ../../library/tkinter.ttk.rst:173 ../../library/tkinter.ttk.rst:216
#: ../../library/tkinter.ttk.rst:232 ../../library/tkinter.ttk.rst:325
#: ../../library/tkinter.ttk.rst:418 ../../library/tkinter.ttk.rst:497
