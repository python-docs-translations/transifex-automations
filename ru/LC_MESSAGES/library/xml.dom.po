msgstr ""

#: ../../library/xml.dom.rst:422
msgid ":attr:`~DocumentType.name`"
msgstr ""

#: ../../library/xml.dom.rst:424
msgid ":attr:`~Element.tagName`"
msgstr ""

#: ../../library/xml.dom.rst:426
