#: ../../library/getpass.rst:2
msgid ":mod:`!getpass` --- Portable password input"
msgstr ":mod:`!getpass` --- Портативный ввод пароля"

#: ../../library/getpass.rst:7
msgid "**Source code:** :source:`Lib/getpass.py`"
msgstr "**Исходный код:** :source:`Lib/getpass.py`"

#: ../../includes/wasm-notavail.rst:3
msgid "Availability"
msgstr "Доступность"

#: ../../includes/wasm-notavail.rst:5
msgid ""
"This module does not work or is not available on WebAssembly. See :ref:`wasm-"
"availability` for more information."
