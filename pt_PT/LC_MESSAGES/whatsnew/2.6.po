#: ../../whatsnew/2.6.rst:531
msgid "Unix and Mac OS X: :file:`~/.local/`"
msgstr "Unix e Mac OS X: :file:`~/.local/`"

#: ../../whatsnew/2.6.rst:532
msgid "Windows: :file:`%APPDATA%/Python`"
msgstr "Windows: :file:`%APPDATA%/Python`"

#: ../../whatsnew/2.6.rst:534
