#: ../../library/tomllib.rst:96
msgid ""
"Added the *msg*, *doc* and *pos* parameters. Added the :attr:`msg`, :attr:"
"`doc`, :attr:`pos`, :attr:`lineno` and :attr:`colno` attributes."
msgstr ""
"Adicionados os parâmetros *msg*, *doc* e *pos*. Adicionados os atributos :"
"attr:`msg`, :attr:`doc`, :attr:`pos`, :attr:`lineno` e :attr:`colno`."

#: ../../library/tomllib.rst:100
msgid "Passing free-form positional arguments is deprecated."
msgstr ""
"A passagem de argumentos posicionais de forma livre é desencorajada "
"(deprecated)."

#: ../../library/tomllib.rst:105
msgid "Examples"
msgstr "Exemplos"

#: ../../library/tomllib.rst:107
msgid "Parsing a TOML file::"
msgstr "Analisar um ficheiro TOML::"

#: ../../library/tomllib.rst:109
msgid ""
"import tomllib\n"
"\n"
"with open(\"pyproject.toml\", \"rb\") as f:\n"
"    data = tomllib.load(f)"
msgstr ""

#: ../../library/tomllib.rst:114
msgid "Parsing a TOML string::"
msgstr "Analisar uma string TOML::"

#: ../../library/tomllib.rst:116
msgid ""
"import tomllib\n"
"\n"
"toml_str = \"\"\"\n"
"python-version = \"3.11.0\"\n"
"python-implementation = \"CPython\"\n"
"\"\"\"\n"
"\n"
"data = tomllib.loads(toml_str)"
msgstr ""

