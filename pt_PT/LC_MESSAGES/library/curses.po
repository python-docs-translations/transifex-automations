#: ../../library/curses.rst:1541
msgid "Clear screen"
msgstr "Limpar ecrã"

#: ../../library/curses.rst:1543
msgid "Clear to end of screen"
msgstr "Limpar até ao final do ecrã"

#: ../../library/curses.rst:1545
