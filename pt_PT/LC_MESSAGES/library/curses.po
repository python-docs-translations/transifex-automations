msgstr ""
"As teclas são referidas por constantes inteiras com nomes que começam com "
"``KEY_``. As teclas exatas disponíveis dependem do sistema."

#: ../../library/curses.rst:1508
msgid "Key constant"
msgstr "Constante de tecla"

