msgstr ""
"Geralmente, :class:`Interpreter` não deve ser chamado diretamente. Em vez "
"disso, utilize :func:`create` ou uma das outras funções do módulo."

#: ../../library/concurrent.interpreters.rst:245
#: ../../library/concurrent.interpreters.rst:251
#: ../../library/concurrent.interpreters.rst:330
msgid "(read-only)"
msgstr "(leitura apenas)"

#: ../../library/concurrent.interpreters.rst:247
msgid "The underlying interpreter's ID."
msgstr "O ID do intérprete subjacente."

#: ../../library/concurrent.interpreters.rst:253
msgid "A string describing where the interpreter came from."
msgstr "Uma string que descreve a origem do intérprete."

#: ../../library/concurrent.interpreters.rst:257
