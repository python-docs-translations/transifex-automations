msgid ""
">>> list(itertools.combinations('123', 2))\n"
"[('1', '2'), ('1', '3'), ('2', '3')]\n"
">>> list(itertools.combinations('123', 3))\n"
"[('1', '2', '3')]\n"
">>> list(itertools.combinations('1234', 3))\n"
"[('1', '2', '3'), ('1', '2', '4'),\n"
" ('1', '3', '4'), ('2', '3', '4')]"
