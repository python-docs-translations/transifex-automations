"    warnings.simplefilter(\"alltid\")\n"
"    # ... kod som utlöser en varning ...\n"
"    assert str(wrec.message) == \"funktionen är föråldrad\"\n"
"    assert len(wrec.warnings) == 1, \"Flera varningar utlöses\""

