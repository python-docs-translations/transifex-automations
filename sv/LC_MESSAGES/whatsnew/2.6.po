">>> def f(**kw):\n"
"...    print sorted(kw)\n"
"...\n"
">>> ud=UserDict.UserDict()\n"
">>> ud['a'] = 1\n"
">>> ud['b'] = 'string'\n"
">>> f(**ud)\n"
