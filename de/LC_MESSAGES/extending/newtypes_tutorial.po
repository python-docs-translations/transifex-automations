"    {Py_mod_multiple_interpreters, "
"Py_MOD_MULTIPLE_INTERPRETERS_NOT_SUPPORTED},\n"
"    {0, NULL}\n"
"};\n"
"\n"
"static PyModuleDef custom_module = {\n"
"    .m_base = PyModuleDef_HEAD_INIT,\n"
"    .m_name = \"custom3\",\n"
"    .m_doc = \"Beispielmodul, das einen Erweiterungstyp erstellt.\",\n"
"    .m_size = 0,\n"
"    .m_slots = custom_module_slots,\n"
"};\n"
"\n"
"PyMODINIT_FUNC\n"
"PyInit_custom3(void)\n"
"{\n"
"    return PyModuleDef_Init(&custom_module);\n"
"}\n"

#: ../../extending/newtypes_tutorial.rst:561
msgid ""
"To provide greater control, over the :attr:`!first` and :attr:`!last` "
"attributes, we'll use custom getter and setter functions.  Here are the "
"functions for getting and setting the :attr:`!first` attribute::"
msgstr ""
"Um eine bessere Kontrolle über die Attribute „ :attr:`!first` “ und „ :attr:"
"`!last` “ zu erhalten, verwenden wir benutzerdefinierte Getter- und Setter-"
"Funktionen. Hier sind die Funktionen zum Abrufen und Setzen des Attributs „ :"
"attr:`!first` “:"

#: ../../extending/newtypes_tutorial.rst:565
msgid ""
"static PyObject *\n"
"Custom_getfirst(PyObject *op, void *closure)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    Py_INCREF(self->first);\n"
"    return self->first;\n"
"}\n"
"\n"
"static int\n"
"Custom_setfirst(PyObject *op, PyObject *value, void *closure)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    PyObject *tmp;\n"
"    if (value == NULL) {\n"
"        PyErr_SetString(PyExc_TypeError, \"Cannot delete the first "
"attribute\");\n"
"        return -1;\n"
"    }\n"
"    if (!PyUnicode_Check(value)) {\n"
"        PyErr_SetString(PyExc_TypeError,\n"
"                        \"The first attribute value must be a string\");\n"
"        return -1;\n"
"    }\n"
"    tmp = self->first;\n"
"    Py_INCREF(value);\n"
"    self->first = value;\n"
"    Py_DECREF(tmp);\n"
"    return 0;\n"
"}"
msgstr ""
"static PyObject *\n"
"Custom_getfirst(PyObject *op, void *closure)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    Py_INCREF(self->first);\n"
"    return self->first;\n"
"}\n"
"\n"
"static int\n"
"Custom_setfirst(PyObject *op, PyObject *value, void *closure)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    PyObject *tmp;\n"
"    if (value == NULL) {\n"
"        PyErr_SetString(PyExc_TypeError, \"Das erste Attribut kann nicht "
"gelöscht werden\");\n"
"        return -1;\n"
"    }\n"
"    if (!PyUnicode_Check(value)) {\n"
"        PyErr_SetString(PyExc_TypeError,\n"
"                        \"Der Wert des ersten Attributs muss eine "
"Zeichenkette sein\");\n"
"        return -1;\n"
"    }\n"
"    tmp = self->first;\n"
"    Py_INCREF(value);\n"
"    self->first = value;\n"
"    Py_DECREF(tmp);\n"
"    return 0;\n"
"}"

#: ../../extending/newtypes_tutorial.rst:594
msgid ""
"The getter function is passed a :class:`!Custom` object and a \"closure\", "
"which is a void pointer.  In this case, the closure is ignored.  (The "
"closure supports an advanced usage in which definition data is passed to the "
"getter and setter. This could, for example, be used to allow a single set of "
"getter and setter functions that decide the attribute to get or set based on "
"data in the closure.)"
msgstr ""
"Der Getter-Funktion werden ein „ :class:`!Custom` “-Objekt und eine "
"„Closure“ übergeben, bei der es sich um einen „void“-Zeiger handelt. In "
"diesem Fall wird die Closure ignoriert.  (Die Closure unterstützt eine "
"erweiterte Verwendung, bei der Definitionsdaten an den Getter und den Setter "
"übergeben werden. Dies könnte beispielsweise genutzt werden, um einen "
"einzigen Satz von Getter- und Setter-Funktionen zu ermöglichen, die anhand "
"der Daten in der Closure entscheiden, welches Attribut abgerufen oder "
"gesetzt werden soll.)"

#: ../../extending/newtypes_tutorial.rst:600
msgid ""
"The setter function is passed the :class:`!Custom` object, the new value, "
"and the closure.  The new value may be ``NULL``, in which case the attribute "
"is being deleted.  In our setter, we raise an error if the attribute is "
"deleted or if its new value is not a string."
msgstr ""
"Der Setter-Funktion werden das Objekt „ :class:`!Custom` “, der neue Wert "
"und die Closure übergeben. Der neue Wert kann „ ``NULL`` “ lauten; in diesem "
"Fall wird das Attribut gelöscht. In unserem Setter lösen wir einen Fehler "
"aus, wenn das Attribut gelöscht wird oder wenn sein neuer Wert keine "
"Zeichenkette ist."

#: ../../extending/newtypes_tutorial.rst:605
msgid "We create an array of :c:type:`PyGetSetDef` structures::"
msgstr ""
"Wir erstellen ein Array von Strukturen vom Typ „ :c:type:`PyGetSetDef` “::"

#: ../../extending/newtypes_tutorial.rst:607
msgid ""
"static PyGetSetDef Custom_getsetters[] = {\n"
"    {\"first\", Custom_getfirst, Custom_setfirst,\n"
"     \"first name\", NULL},\n"
"    {\"last\", Custom_getlast, Custom_setlast,\n"
"     \"last name\", NULL},\n"
"    {NULL}  /* Sentinel */\n"
"};"
msgstr ""
"static PyGetSetDef Custom_getsetters[] = {\n"
"    {\"first\", Custom_getfirst, Custom_setfirst,\n"
"     \"Vorname\", NULL},\n"
"    {\"last\", Custom_getlast, Custom_setlast,\n"
"     \"Nachname\", NULL},\n"
"    {NULL}  /* Sentinel */\n"
"};"

#: ../../extending/newtypes_tutorial.rst:615
msgid "and register it in the :c:member:`~PyTypeObject.tp_getset` slot::"
msgstr ""
"und registrieren Sie es im Slot „ :c:member:`~PyTypeObject.tp_getset` “::"

#: ../../extending/newtypes_tutorial.rst:617
msgid ".tp_getset = Custom_getsetters,"
msgstr ".tp_getset = Custom_getsetters,"

#: ../../extending/newtypes_tutorial.rst:619
msgid ""
"The last item in a :c:type:`PyGetSetDef` structure is the \"closure\" "
"mentioned above.  In this case, we aren't using a closure, so we just pass "
"``NULL``."
msgstr ""
"Das letzte Element in einer „ :c:type:`PyGetSetDef` “-Struktur ist die oben "
"erwähnte „Closure“. In diesem Fall verwenden wir keine Closure, daher "
"übergeben wir einfach ` ``NULL```."

#: ../../extending/newtypes_tutorial.rst:622
msgid "We also remove the member definitions for these attributes::"
msgstr "Außerdem entfernen wir die Member-Definitionen für diese Attribute::"

#: ../../extending/newtypes_tutorial.rst:624
msgid ""
"static PyMemberDef Custom_members[] = {\n"
"    {\"number\", Py_T_INT, offsetof(CustomObject, number), 0,\n"
"     \"custom number\"},\n"
"    {NULL}  /* Sentinel */\n"
"};"
msgstr ""
"static PyMemberDef Custom_members[] = {\n"
"    {\"number\", Py_T_INT, offsetof(CustomObject, number), 0,\n"
"     \"custom number\"},\n"
"    {NULL}  /* Sentinel */\n"
"};"

#: ../../extending/newtypes_tutorial.rst:630
msgid ""
"We also need to update the :c:member:`~PyTypeObject.tp_init` handler to only "
"allow strings [#]_ to be passed::"
msgstr ""
"Außerdem müssen wir den Handler „ :c:member:`~PyTypeObject.tp_init` “ so "
"anpassen, dass nur Zeichenfolgen vom Typ „ [#]_ “ übergeben werden dürfen::"

#: ../../extending/newtypes_tutorial.rst:633
msgid ""
"static int\n"
"Custom_init(PyObject *op, PyObject *args, PyObject *kwds)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    static char *kwlist[] = {\"first\", \"last\", \"number\", NULL};\n"
"    PyObject *first = NULL, *last = NULL, *tmp;\n"
"\n"
"    if (!PyArg_ParseTupleAndKeywords(args, kwds, \"|UUi\", kwlist,\n"
"                                     &first, &last,\n"
"                                     &self->number))\n"
"        return -1;\n"
"\n"
"    if (first) {\n"
"        tmp = self->first;\n"
"        Py_INCREF(first);\n"
"        self->first = first;\n"
"        Py_DECREF(tmp);\n"
"    }\n"
"    if (last) {\n"
"        tmp = self->last;\n"
"        Py_INCREF(last);\n"
"        self->last = last;\n"
"        Py_DECREF(tmp);\n"
"    }\n"
"    return 0;\n"
"}"
msgstr ""
"static int\n"
"Custom_init(PyObject *op, PyObject *args, PyObject *kwds)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    static char *kwlist[] = {\"first\", \"last\", \"number\", NULL};\n"
"    PyObject *first = NULL, *last = NULL, *tmp;\n"
"\n"
"    if (!PyArg_ParseTupleAndKeywords(args, kwds, \"|UUi\", kwlist,\n"
"                                     &first, &last,\n"
"                                     &self->number))\n"
"        return -1;\n"
"\n"
"    if (first) {\n"
"        tmp = self->first;\n"
"        Py_INCREF(first);\n"
"        self->first = first;\n"
"        Py_DECREF(tmp);\n"
"    }\n"
"    if (last) {\n"
"        tmp = self->last;\n"
"        Py_INCREF(last);\n"
"        self->last = last;\n"
"        Py_DECREF(tmp);\n"
"    }\n"
"    return 0;\n"
"}"

#: ../../extending/newtypes_tutorial.rst:660
msgid ""
"With these changes, we can assure that the ``first`` and ``last`` members "
"are never ``NULL`` so we can remove checks for ``NULL`` values in almost all "
"cases. This means that most of the :c:func:`Py_XDECREF` calls can be "
"converted to :c:func:`Py_DECREF` calls.  The only place we can't change "
"these calls is in the ``tp_dealloc`` implementation, where there is the "
"possibility that the initialization of these members failed in ``tp_new``."
msgstr ""
"Mit diesen Änderungen können wir sicherstellen, dass die Mitglieder "
"„ ``first`` “ und „ ``last`` “ niemals „ ``NULL`` “ sind, sodass wir die "
"Prüfungen auf „ ``NULL`` “-Werte in fast allen Fällen entfernen können. Das "
"bedeutet, dass die meisten „ :c:func:`Py_XDECREF` “-Aufrufe in „ :c:func:"
"`Py_DECREF` “-Aufrufe umgewandelt werden können. Die einzige Stelle, an der "
"wir diese Aufrufe nicht ändern können, ist die Implementierung von "
"„ ``tp_dealloc`` “, wo die Möglichkeit besteht, dass die Initialisierung "
"dieser Mitglieder in „ ``tp_new`` “ fehlgeschlagen ist."

#: ../../extending/newtypes_tutorial.rst:667
msgid ""
"We also rename the module initialization function and module name in the "
"initialization function, as we did before, and we add an extra definition to "
"the :file:`setup.py` file."
msgstr ""
"Außerdem benennen wir die Initialisierungsfunktion des Moduls und den "
"Modulnamen in der Initialisierungsfunktion wie zuvor um und fügen der Datei "
"„ :file:`setup.py` “ eine zusätzliche Definition hinzu."

#: ../../extending/newtypes_tutorial.rst:673
msgid "Supporting cyclic garbage collection"
msgstr "Unterstützung der zyklischen Speicherbereinigung"

#: ../../extending/newtypes_tutorial.rst:675
msgid ""
"Python has a :term:`cyclic garbage collector (GC) <garbage collection>` that "
"can identify unneeded objects even when their reference counts are not zero. "
"This can happen when objects are involved in cycles.  For example, consider:"
msgstr ""
"Python verfügt über einen :term:`zyklischen Garbage Collector (GC) <garbage "
"collection>`, der nicht mehr benötigte Objekte auch dann identifizieren "
"kann, wenn deren Referenzanzahl nicht Null ist. Dies kann passieren, wenn "
"Objekte in Zyklen eingebunden sind. Betrachten wir zum Beispiel Folgendes:"

#: ../../extending/newtypes_tutorial.rst:679
msgid ""
">>> l = []\n"
">>> l.append(l)\n"
">>> del l"
msgstr ""
">>> l = []\n"
">>> l.append(l)\n"
">>> del l"

#: ../../extending/newtypes_tutorial.rst:685
msgid ""
"In this example, we create a list that contains itself. When we delete it, "
"it still has a reference from itself. Its reference count doesn't drop to "
"zero. Fortunately, Python's cyclic garbage collector will eventually figure "
"out that the list is garbage and free it."
msgstr ""
"In diesem Beispiel erstellen wir eine Liste, die sich selbst enthält. Wenn "
"wir sie löschen, besteht weiterhin ein Verweis von ihr auf sich selbst. Ihre "
"Referenzanzahl sinkt nicht auf null. Glücklicherweise wird der zyklische "
"Garbage Collector von Python irgendwann erkennen, dass die Liste Müll ist, "
"und sie freigeben."

#: ../../extending/newtypes_tutorial.rst:690
msgid ""
"In the second version of the :class:`!Custom` example, we allowed any kind "
"of object to be stored in the :attr:`!first` or :attr:`!last` attributes "
"[#]_. Besides, in the second and third versions, we allowed subclassing :"
"class:`!Custom`, and subclasses may add arbitrary attributes.  For any of "
"those two reasons, :class:`!Custom` objects can participate in cycles:"
msgstr ""
"In der zweiten Version des Beispiels „ :class:`!Custom` “ haben wir "
"zugelassen, dass beliebige Objekte in den Attributen „ :attr:`!first` “ oder "
"„ :attr:`!last` “ gespeichert werden können [#]_. Außerdem haben wir in der "
"zweiten und dritten Version die Erstellung von Unterklassen erlaubt :class:`!"
"Custom`, und Unterklassen können beliebige Attribute hinzufügen. Aus jedem "
"dieser beiden Gründe können :class:`!Custom` -Objekte an Zyklen beteiligt "
"sein:"

#: ../../extending/newtypes_tutorial.rst:696
msgid ""
">>> import custom3\n"
">>> class Derived(custom3.Custom): pass\n"
"...\n"
">>> n = Derived()\n"
">>> n.some_attribute = n"
msgstr ""
">>> import custom3\n"
">>> class Derived(custom3.Custom): pass\n"
"...\n"
">>> n = Derived()\n"
">>> n.some_attribute = n"

#: ../../extending/newtypes_tutorial.rst:704
msgid ""
"To allow a :class:`!Custom` instance participating in a reference cycle to "
"be properly detected and collected by the cyclic GC, our :class:`!Custom` "
"type needs to fill two additional slots and to enable a flag that enables "
"these slots:"
msgstr ""
"Damit eine an einem Referenzzyklus beteiligte Instanz von „ :class:`!Custom` "
"“ vom zyklischen GC ordnungsgemäß erkannt und gesammelt werden kann, muss "
"unser Typ „ :class:`!Custom` “ zwei zusätzliche Slots füllen und ein Flag "
"setzen, das diese Slots aktiviert:"

#: ../../extending/newtypes_tutorial.rst:708
msgid ""
"#define PY_SSIZE_T_CLEAN\n"
"#include <Python.h>\n"
"#include <stddef.h> /* for offsetof() */\n"
"\n"
"typedef struct {\n"
"    PyObject_HEAD\n"
"    PyObject *first; /* first name */\n"
"    PyObject *last;  /* last name */\n"
"    int number;\n"
"} CustomObject;\n"
"\n"
"static int\n"
"Custom_traverse(PyObject *op, visitproc visit, void *arg)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    Py_VISIT(self->first);\n"
"    Py_VISIT(self->last);\n"
"    return 0;\n"
"}\n"
"\n"
"static int\n"
"Custom_clear(PyObject *op)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    Py_CLEAR(self->first);\n"
"    Py_CLEAR(self->last);\n"
"    return 0;\n"
"}\n"
"\n"
"static void\n"
"Custom_dealloc(PyObject *op)\n"
"{\n"
"    PyObject_GC_UnTrack(op);\n"
"    (void)Custom_clear(op);\n"
"    Py_TYPE(op)->tp_free(op);\n"
"}\n"
"\n"
"static PyObject *\n"
"Custom_new(PyTypeObject *type, PyObject *args, PyObject *kwds)\n"
"{\n"
"    CustomObject *self;\n"
"    self = (CustomObject *) type->tp_alloc(type, 0);\n"
"    if (self != NULL) {\n"
"        self->first = Py_GetConstant(Py_CONSTANT_EMPTY_STR);\n"
"        if (self->first == NULL) {\n"
"            Py_DECREF(self);\n"
"            return NULL;\n"
"        }\n"
"        self->last = Py_GetConstant(Py_CONSTANT_EMPTY_STR);\n"
"        if (self->last == NULL) {\n"
"            Py_DECREF(self);\n"
"            return NULL;\n"
"        }\n"
"        self->number = 0;\n"
"    }\n"
"    return (PyObject *) self;\n"
"}\n"
"\n"
"static int\n"
"Custom_init(PyObject *op, PyObject *args, PyObject *kwds)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    static char *kwlist[] = {\"first\", \"last\", \"number\", NULL};\n"
"    PyObject *first = NULL, *last = NULL;\n"
"\n"
"    if (!PyArg_ParseTupleAndKeywords(args, kwds, \"|UUi\", kwlist,\n"
"                                     &first, &last,\n"
"                                     &self->number))\n"
"        return -1;\n"
"\n"
"    if (first) {\n"
"        Py_SETREF(self->first, Py_NewRef(first));\n"
"    }\n"
"    if (last) {\n"
"        Py_SETREF(self->last, Py_NewRef(last));\n"
"    }\n"
"    return 0;\n"
"}\n"
"\n"
"static PyMemberDef Custom_members[] = {\n"
"    {\"number\", Py_T_INT, offsetof(CustomObject, number), 0,\n"
"     \"custom number\"},\n"
"    {NULL}  /* Sentinel */\n"
"};\n"
"\n"
"static PyObject *\n"
"Custom_getfirst(PyObject *op, void *closure)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    return Py_NewRef(self->first);\n"
"}\n"
"\n"
"static int\n"
"Custom_setfirst(PyObject *op, PyObject *value, void *closure)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    if (value == NULL) {\n"
"        PyErr_SetString(PyExc_TypeError, \"Cannot delete the first "
"attribute\");\n"
"        return -1;\n"
"    }\n"
"    if (!PyUnicode_Check(value)) {\n"
"        PyErr_SetString(PyExc_TypeError,\n"
"                        \"The first attribute value must be a string\");\n"
"        return -1;\n"
"    }\n"
"    Py_XSETREF(self->first, Py_NewRef(value));\n"
"    return 0;\n"
"}\n"
"\n"
"static PyObject *\n"
"Custom_getlast(PyObject *op, void *closure)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    return Py_NewRef(self->last);\n"
"}\n"
"\n"
"static int\n"
"Custom_setlast(PyObject *op, PyObject *value, void *closure)\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    if (value == NULL) {\n"
"        PyErr_SetString(PyExc_TypeError, \"Cannot delete the last "
"attribute\");\n"
"        return -1;\n"
"    }\n"
"    if (!PyUnicode_Check(value)) {\n"
"        PyErr_SetString(PyExc_TypeError,\n"
"                        \"The last attribute value must be a string\");\n"
"        return -1;\n"
"    }\n"
"    Py_XSETREF(self->last, Py_NewRef(value));\n"
"    return 0;\n"
"}\n"
"\n"
"static PyGetSetDef Custom_getsetters[] = {\n"
"    {\"first\", Custom_getfirst, Custom_setfirst,\n"
"     \"first name\", NULL},\n"
"    {\"last\", Custom_getlast, Custom_setlast,\n"
"     \"last name\", NULL},\n"
"    {NULL}  /* Sentinel */\n"
"};\n"
"\n"
"static PyObject *\n"
"Custom_name(PyObject *op, PyObject *Py_UNUSED(dummy))\n"
"{\n"
"    CustomObject *self = (CustomObject *) op;\n"
"    return PyUnicode_FromFormat(\"%S %S\", self->first, self->last);\n"
"}\n"
"\n"
"static PyMethodDef Custom_methods[] = {\n"
"    {\"name\", Custom_name, METH_NOARGS,\n"
"     \"Return the name, combining the first and last name\"\n"
"    },\n"
"    {NULL}  /* Sentinel */\n"
"};\n"
"\n"
"static PyTypeObject CustomType = {\n"
"    .ob_base = PyVarObject_HEAD_INIT(NULL, 0)\n"
"    .tp_name = \"custom4.Custom\",\n"
"    .tp_doc = PyDoc_STR(\"Custom objects\"),\n"
