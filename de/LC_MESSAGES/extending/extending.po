"{\n"
"    int voltage;\n"
"    const char *state = \"a stiff\";\n"
"    const char *action = \"voom\";\n"
"    const char *type = \"Norwegian Blue\";\n"
"\n"
"    static char *kwlist[] = {\"voltage\", \"state\", \"action\", \"type\", "
"NULL};\n"
"\n"
"    if (!PyArg_ParseTupleAndKeywords(args, keywds, \"i|sss\", kwlist,\n"
"                                     &voltage, &state, &action, &type))\n"
"        return NULL;\n"
"\n"
"    printf(\"-- Dieser Papagei würde nicht ‚ %s ‘ sagen, wenn man ihn mit %i "
"Volt versorgen würde.\\n\",\n"
"           action, voltage);\n"
"    printf(\"-- Wunderschönes Gefieder, der ‚ %s ‘ -- Es ist ‚ %s ‘!\\n\", "
"type, state);\n"
"\n"
"    Py_RETURN_NONE;\n"
"}\n"
"\n"
"static PyMethodDef keywdarg_methods[] = {\n"
"    /* Der Typumwandlung der Funktion ist notwendig, da PyCFunction-Werte\n"
