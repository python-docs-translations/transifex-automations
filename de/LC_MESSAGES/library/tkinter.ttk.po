#: ../../library/tkinter.ttk.rst:887
msgid "Option"
msgstr "Option"

#: ../../library/tkinter.ttk.rst:110 ../../library/tkinter.ttk.rst:145
#: ../../library/tkinter.ttk.rst:171 ../../library/tkinter.ttk.rst:214
#: ../../library/tkinter.ttk.rst:230 ../../library/tkinter.ttk.rst:317
#: ../../library/tkinter.ttk.rst:403 ../../library/tkinter.ttk.rst:479
#: ../../library/tkinter.ttk.rst:505 ../../library/tkinter.ttk.rst:669
