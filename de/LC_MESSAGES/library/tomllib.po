#: ../../library/tomllib.rst:78
msgid "Parsing a TOML file::"
msgstr "Eine TOML-Datei parsen::"

#: ../../library/tomllib.rst:80
msgid ""
"import tomllib\n"
"\n"
"with open(\"pyproject.toml\", \"rb\") as f:\n"
"    data = tomllib.load(f)"
msgstr ""
"import tomllib\n"
"\n"
"with open(\"pyproject.toml\", \"rb\") as f:\n"
"    data = tomllib.load(f)"

#: ../../library/tomllib.rst:85
msgid "Parsing a TOML string::"
msgstr "Eine TOML-Zeichenkette parsen::"

#: ../../library/tomllib.rst:87
msgid ""
"import tomllib\n"
"\n"
"toml_str = \"\"\"\n"
"python-version = \"3.11.0\"\n"
"python-implementation = \"CPython\"\n"
"\"\"\"\n"
"\n"
"data = tomllib.loads(toml_str)"
msgstr ""
"import tomllib\n"
"\n"
"toml_str = \"\"\"\n"
"python-version = \"3.11.0\"\n"
"python-implementation = \"CPython\"\n"
"\"\"\"\n"
"\n"
"data = tomllib.loads(toml_str)"

