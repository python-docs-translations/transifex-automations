msgstr "Die Spalte, die *pos* entspricht."

#: ../../library/tomllib.rst:96
msgid ""
"Added the *msg*, *doc* and *pos* parameters. Added "
"the :attr:`msg`, :attr:`doc`, :attr:`pos`, :attr:`lineno` and :attr:`colno` "
"attributes."
msgstr ""
"Die Parameter *msg*, *doc* und *pos* wurden hinzugefügt. Die "
"Attribute :attr:`msg`, :attr:`doc`, :attr:`pos`, :attr:`lineno` "
"und :attr:`colno` wurden hinzugefügt."

#: ../../library/tomllib.rst:100
msgid "Passing free-form positional arguments is deprecated."
msgstr "Das Übergeben formfreier Positionsargumente ist veraltet."

#: ../../library/tomllib.rst:105
msgid "Examples"
msgstr "Beispiele"

#: ../../library/tomllib.rst:107
msgid "Parsing a TOML file::"
msgstr "Eine TOML-Datei parsen::"

#: ../../library/tomllib.rst:109
msgid ""
"import tomllib\n"
"\n"
"with open(\"pyproject.toml\", \"rb\") as f:\n"
"    data = tomllib.load(f)"
msgstr ""
"import tomllib\n"
"\n"
"with open(\"pyproject.toml\", \"rb\") as f:\n"
"    data = tomllib.load(f)"

#: ../../library/tomllib.rst:114
msgid "Parsing a TOML string::"
msgstr "Eine TOML-Zeichenkette parsen::"

#: ../../library/tomllib.rst:116
msgid ""
"import tomllib\n"
"\n"
"toml_str = \"\"\"\n"
"python-version = \"3.11.0\"\n"
"python-implementation = \"CPython\"\n"
"\"\"\"\n"
"\n"
"data = tomllib.loads(toml_str)"
msgstr ""
"import tomllib\n"
"\n"
"toml_str = \"\"\"\n"
"python-version = \"3.11.0\"\n"
"python-implementation = \"CPython\"\n"
"\"\"\"\n"
"\n"
"data = tomllib.loads(toml_str)"

