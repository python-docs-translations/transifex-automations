#: ../../library/json.rst:761
msgid "Footnotes"
msgstr "Fußnoten"

#: ../../library/json.rst:762
msgid ""
"As noted in `the errata for RFC 7159 <https://www.rfc-editor.org/"
"errata_search.php?rfc=7159>`_, JSON permits literal U+2028 (LINE SEPARATOR) "
"and U+2029 (PARAGRAPH SEPARATOR) characters in strings, whereas JavaScript "
"(as of ECMAScript Edition 5.1) does not."
msgstr ""
"Wie in `den Errata zu RFC 7159 <https://www.rfc-editor.org/errata_search.php?"
"rfc=7159>`_ vermerkt, erlaubt JSON die Zeichen U+2028 (LINE SEPARATOR) und "
"U+2029 (PARAGRAPH SEPARATOR) wörtlich in Zeichenketten, JavaScript (ab "
"ECMAScript Edition 5.1) hingegen nicht."
