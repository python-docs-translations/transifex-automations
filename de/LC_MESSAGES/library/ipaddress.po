"3232235521\n"
">>> str(ipaddress.IPv6Address('::1'))\n"
"'::1'\n"
">>> int(ipaddress.IPv6Address('::1'))\n"
"1"

#: ../../library/ipaddress.rst:419
msgid ""
"Note that IPv6 scoped addresses are converted to integers without scope zone "
"ID."
msgstr ""
"Beachte, dass IPv6-Adressen mit Gültigkeitsbereich ohne Scope-Zone-ID in "
"ganze Zahlen umgewandelt werden."

