msgstr "90 - Nord"

#: ../../library/turtle.rst:692
msgid "90 - east"
msgstr "90 - Ost"

#: ../../library/turtle.rst:693
msgid "180 - west"
msgstr "180 - West"

#: ../../library/turtle.rst:693
