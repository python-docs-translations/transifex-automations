"Set the turtle's second coordinate to *y*, leave first coordinate unchanged."
msgstr ""
"Setze die zweite Koordinate der Turtle auf *y*, die erste Koordinate bleibt "
"unverändert."

#: ../../library/turtle.rst:639
msgid ""
">>> turtle.position()\n"
"(0.00,40.00)\n"
">>> turtle.sety(-10)\n"
">>> turtle.position()\n"
"(0.00,-10.00)"
