"    ...\n"
"\n"
"asyncio.run(main())"
msgstr ""
"async def main():\n"
"    ...\n"
"\n"
"asyncio.run(main())"

#: ../../whatsnew/3.14.rst:2445
msgid ""
"If you need to start something, for example, a server listening on a socket "
"and then run forever, use :func:`asyncio.run` and an :class:`asyncio.Event`."
msgstr ""
"Wenn du etwas starten musst, zum Beispiel einen Server, der an einem Socket "
"lauscht, und das dann dauerhaft laufen lassen willst, "
"verwende :func:`asyncio.run` und ein :class:`asyncio.Event`."

#: ../../whatsnew/3.14.rst:2451
msgid ""
"def start_server(loop): ...\n"
"\n"
"loop = asyncio.get_event_loop()\n"
"try:\n"
"    start_server(loop)\n"
"    loop.run_forever()\n"
"finally:\n"
"    loop.close()"
msgstr ""
"def start_server(loop): ...\n"
"\n"
"loop = asyncio.get_event_loop()\n"
"try:\n"
"    start_server(loop)\n"
"    loop.run_forever()\n"
"finally:\n"
"    loop.close()"

#: ../../whatsnew/3.14.rst:2464
msgid ""
"def start_server(loop): ...\n"
"\n"
"async def main():\n"
"    start_server(asyncio.get_running_loop())\n"
"    await asyncio.Event().wait()\n"
"\n"
"asyncio.run(main())"
msgstr ""
"def start_server(loop): ...\n"
"\n"
"async def main():\n"
"    start_server(asyncio.get_running_loop())\n"
"    await asyncio.Event().wait()\n"
"\n"
"asyncio.run(main())"

#: ../../whatsnew/3.14.rst:2474
msgid ""
"If you need to run something in an event loop, then run some blocking code "
"around it, use :class:`asyncio.Runner`."
msgstr ""
"Wenn du etwas in einer Ereignisschleife ausführen und darum herum "
"blockierenden Code laufen lassen musst, verwende :class:`asyncio.Runner`."

#: ../../whatsnew/3.14.rst:2479
msgid ""
"async def operation_one(): ...\n"
"def blocking_code(): ...\n"
"async def operation_two(): ...\n"
"\n"
"loop = asyncio.get_event_loop()\n"
"try:\n"
"    loop.run_until_complete(operation_one())\n"
"    blocking_code()\n"
"    loop.run_until_complete(operation_two())\n"
"finally:\n"
"    loop.close()"
msgstr ""
"async def operation_one(): ...\n"
"def blocking_code(): ...\n"
"async def operation_two(): ...\n"
"\n"
"loop = asyncio.get_event_loop()\n"
"try:\n"
"    loop.run_until_complete(operation_one())\n"
"    blocking_code()\n"
"    loop.run_until_complete(operation_two())\n"
"finally:\n"
"    loop.close()"

#: ../../whatsnew/3.14.rst:2495
msgid ""
"async def operation_one(): ...\n"
"def blocking_code(): ...\n"
"async def operation_two(): ...\n"
"\n"
"with asyncio.Runner() as runner:\n"
"    runner.run(operation_one())\n"
"    blocking_code()\n"
"    runner.run(operation_two())"
msgstr ""
"async def operation_one(): ...\n"
"def blocking_code(): ...\n"
"async def operation_two(): ...\n"
"\n"
"with asyncio.Runner() as runner:\n"
"    runner.run(operation_one())\n"
"    blocking_code()\n"
"    runner.run(operation_two())"

