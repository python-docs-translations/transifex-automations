msgstr "``TESTTIMEOUT``: Zeitgrenze in Sekunden (Vorgabe: 10 Minuten)."

#: ../../using/configure.rst:1454
msgid "make ci"
msgstr "make ci"

#: ../../using/configure.rst:1456
