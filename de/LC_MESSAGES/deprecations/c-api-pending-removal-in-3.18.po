#: ../../deprecations/c-api-pending-removal-in-3.18.rst:2
msgid "Pending removal in Python 3.18"
msgstr "Geplante Entfernung in Python 3.18"

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:4
msgid ""
"The following private functions are deprecated and planned for removal in "
"Python 3.18:"
msgstr ""
"Die folgenden privaten Funktionen sind als veraltet markiert, die Entfernung "
"ist für Python 3.18 geplant:"

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:7
msgid ":c:func:`!_PyBytes_Join`: use :c:func:`PyBytes_Join`."
msgstr ":c:func:`!_PyBytes_Join`: verwende :c:func:`PyBytes_Join`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:8
msgid ""
":c:func:`!_PyDict_GetItemStringWithError`: "
"use :c:func:`PyDict_GetItemStringRef`."
msgstr ""
":c:func:`!_PyDict_GetItemStringWithError`: "
"verwende :c:func:`PyDict_GetItemStringRef`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:9
msgid ":c:func:`!_PyDict_Pop()`: use :c:func:`PyDict_Pop`."
msgstr ":c:func:`!_PyDict_Pop()`: verwende :c:func:`PyDict_Pop`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:10
msgid ":c:func:`!_PyLong_Sign()`: use :c:func:`PyLong_GetSign`."
msgstr ":c:func:`!_PyLong_Sign()`: verwende :c:func:`PyLong_GetSign`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:11
msgid ""
":c:func:`!_PyLong_FromDigits` and :c:func:`!_PyLong_New`: "
"use :c:func:`PyLongWriter_Create`."
msgstr ""
":c:func:`!_PyLong_FromDigits` und :c:func:`!_PyLong_New`: "
"verwende :c:func:`PyLongWriter_Create`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:13
msgid ""
":c:func:`!_PyThreadState_UncheckedGet`: "
"use :c:func:`PyThreadState_GetUnchecked`."
msgstr ""
":c:func:`!_PyThreadState_UncheckedGet`: "
"verwende :c:func:`PyThreadState_GetUnchecked`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:14
msgid ":c:func:`!_PyUnicode_AsString`: use :c:func:`PyUnicode_AsUTF8`."
msgstr ":c:func:`!_PyUnicode_AsString`: verwende :c:func:`PyUnicode_AsUTF8`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:15
msgid ""
":c:func:`!_PyUnicodeWriter_Init`: replace ``_PyUnicodeWriter_Init(&writer)`` "
"with :c:func:`writer = PyUnicodeWriter_Create(0) <PyUnicodeWriter_Create>`."
msgstr ""
":c:func:`!_PyUnicodeWriter_Init`: ersetze ``_PyUnicodeWriter_Init(&writer)`` "
"durch :c:func:`writer = PyUnicodeWriter_Create(0) <PyUnicodeWriter_Create>`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:18
msgid ""
":c:func:`!_PyUnicodeWriter_Finish`: replace "
"``_PyUnicodeWriter_Finish(&writer)`` "
"with :c:func:`PyUnicodeWriter_Finish(writer) <PyUnicodeWriter_Finish>`."
msgstr ""
":c:func:`!_PyUnicodeWriter_Finish`: ersetze "
"``_PyUnicodeWriter_Finish(&writer)`` "
"durch :c:func:`PyUnicodeWriter_Finish(writer) <PyUnicodeWriter_Finish>`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:21
msgid ""
":c:func:`!_PyUnicodeWriter_Dealloc`: replace "
"``_PyUnicodeWriter_Dealloc(&writer)`` "
"with :c:func:`PyUnicodeWriter_Discard(writer) <PyUnicodeWriter_Discard>`."
msgstr ""
":c:func:`!_PyUnicodeWriter_Dealloc`: ersetze "
"``_PyUnicodeWriter_Dealloc(&writer)`` "
"durch :c:func:`PyUnicodeWriter_Discard(writer) <PyUnicodeWriter_Discard>`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:24
msgid ""
":c:func:`!_PyUnicodeWriter_WriteChar`: replace "
"``_PyUnicodeWriter_WriteChar(&writer, ch)`` "
"with :c:func:`PyUnicodeWriter_WriteChar(writer, ch) "
"<PyUnicodeWriter_WriteChar>`."
msgstr ""
":c:func:`!_PyUnicodeWriter_WriteChar`: ersetze "
"``_PyUnicodeWriter_WriteChar(&writer, ch)`` "
"durch :c:func:`PyUnicodeWriter_WriteChar(writer, ch) "
"<PyUnicodeWriter_WriteChar>`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:27
msgid ""
":c:func:`!_PyUnicodeWriter_WriteStr`: replace "
"``_PyUnicodeWriter_WriteStr(&writer, str)`` "
"with :c:func:`PyUnicodeWriter_WriteStr(writer, str) "
"<PyUnicodeWriter_WriteStr>`."
msgstr ""
":c:func:`!_PyUnicodeWriter_WriteStr`: ersetze "
"``_PyUnicodeWriter_WriteStr(&writer, str)`` "
"durch :c:func:`PyUnicodeWriter_WriteStr(writer, str) "
"<PyUnicodeWriter_WriteStr>`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:30
msgid ""
":c:func:`!_PyUnicodeWriter_WriteSubstring`: replace "
"``_PyUnicodeWriter_WriteSubstring(&writer, str, start, end)`` "
"with :c:func:`PyUnicodeWriter_WriteSubstring(writer, str, start, end) "
"<PyUnicodeWriter_WriteSubstring>`."
msgstr ""
":c:func:`!_PyUnicodeWriter_WriteSubstring`: ersetze "
"``_PyUnicodeWriter_WriteSubstring(&writer, str, start, end)`` "
"durch :c:func:`PyUnicodeWriter_WriteSubstring(writer, str, start, end) "
"<PyUnicodeWriter_WriteSubstring>`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:33
msgid ""
":c:func:`!_PyUnicodeWriter_WriteASCIIString`: replace "
"``_PyUnicodeWriter_WriteASCIIString(&writer, str, size)`` "
"with :c:func:`PyUnicodeWriter_WriteASCII(writer, str, size) "
"<PyUnicodeWriter_WriteASCII>`."
msgstr ""
":c:func:`!_PyUnicodeWriter_WriteASCIIString`: ersetze "
"``_PyUnicodeWriter_WriteASCIIString(&writer, str, size)`` "
"durch :c:func:`PyUnicodeWriter_WriteASCII(writer, str, size) "
"<PyUnicodeWriter_WriteASCII>`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:36
msgid ""
":c:func:`!_PyUnicodeWriter_WriteLatin1String`: replace "
"``_PyUnicodeWriter_WriteLatin1String(&writer, str, size)`` by decoding the "
"string with :c:func:`PyUnicode_DecodeLatin1`, writing the result "
"with :c:func:`PyUnicodeWriter_WriteStr`, and releasing the result "
"with :c:func:`Py_DECREF`."
msgstr ""
":c:func:`!_PyUnicodeWriter_WriteLatin1String`: ersetze "
"``_PyUnicodeWriter_WriteLatin1String(&writer, str, size)``, indem du die "
"Zeichenkette mit :c:func:`PyUnicode_DecodeLatin1` dekodierst, das Ergebnis "
"mit :c:func:`PyUnicodeWriter_WriteStr` schreibst und es "
"mit :c:func:`Py_DECREF` freigibst."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:41
msgid ":c:func:`!_PyUnicodeWriter_Prepare`: (no replacement)."
msgstr ":c:func:`!_PyUnicodeWriter_Prepare`: (kein Ersatz)."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:42
msgid ":c:func:`!_PyUnicodeWriter_PrepareKind`: (no replacement)."
msgstr ":c:func:`!_PyUnicodeWriter_PrepareKind`: (kein Ersatz)."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:43
msgid ":c:func:`!_Py_HashPointer`: use :c:func:`Py_HashPointer`."
msgstr ":c:func:`!_Py_HashPointer`: verwende :c:func:`Py_HashPointer`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:44
msgid ":c:func:`!_Py_fopen_obj`: use :c:func:`Py_fopen`."
msgstr ":c:func:`!_Py_fopen_obj`: verwende :c:func:`Py_fopen`."

#: ../../deprecations/c-api-pending-removal-in-3.18.rst:46
msgid ""
"The `pythoncapi-compat project <https://github.com/python/pythoncapi-compat/"
">`__ can be used to get these new public functions on Python 3.13 and older. "
"(Contributed by Victor Stinner in :gh:`128863`.)"
msgstr ""
"Mit dem `Projekt pythoncapi-compat <https://github.com/python/pythoncapi-"
"compat/>`__ lassen sich diese neuen öffentlichen Funktionen auch unter "
"Python 3.13 und älter nutzen. (Beigetragen von Victor Stinner "
"in :gh:`128863`.)"
