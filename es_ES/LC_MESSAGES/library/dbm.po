#: ../../library/dbm.rst:187
msgid ""
"``'f'``: Open the database in fast mode. Writes to the database will not be "
"synchronized."
msgstr ""
"``'f'``: Abre la base de datos en modo rápido. Las escrituras en la base de "
"datos no se sincronizarán."

#: ../../library/dbm.rst:189
msgid ""
"``'s'``: Synchronized mode. Changes to the database will be written "
"immediately to the file."
msgstr ""
"``'s'``: Modo sincronizado. Los cambios en la base de datos se escribirán "
"inmediatamente en el archivo."

#: ../../library/dbm.rst:191
msgid "``'u'``: Do not lock database."
msgstr "``'u'``: No bloquear la base de datos."

#: ../../library/dbm.rst:193
msgid ""
"Not all flags are valid for all versions of GDBM. See the :data:`open_flags` "
"member for a list of supported flag characters."
msgstr ""
"No todos los indicadores son válidos para todas las versiones de GDBM. "
