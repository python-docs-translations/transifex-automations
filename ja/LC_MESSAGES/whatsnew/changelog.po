msgstr ":issue:`27593`: sys.version に使う git の情報の形式を修正しました。"

#: ../../../build/NEWS:30292
msgid "Fix incompatible comment in python.h"
msgstr "python.h の互換性のないコメントを修正しました。"

#: ../../../build/NEWS:30296
msgid "Python 3.6.1 release candidate 1"
msgstr "Python 3.6.1 リリース候補 1"

