msgstr "``siphash13`` (デフォルト);"

#: ../../using/configure.rst:1050
msgid "``siphash24``;"
msgstr "``siphash24``;"

#: ../../using/configure.rst:1051
msgid "``fnv``."
msgstr "``fnv``。"

#: ../../using/configure.rst:1055
msgid "``siphash13`` is added and it is the new default."
msgstr "``siphash13`` が追加され、新たなデフォルトになりました。"

#: ../../using/configure.rst:1060
msgid "Built-in hash modules:"
msgstr "組み込みのハッシュモジュール:"

#: ../../using/configure.rst:1062
msgid "``md5``;"
msgstr "``md5``;"

#: ../../using/configure.rst:1063
msgid "``sha1``;"
msgstr "``sha1``;"

#: ../../using/configure.rst:1064
msgid "``sha256``;"
msgstr "``sha256``;"

#: ../../using/configure.rst:1065
msgid "``sha512``;"
msgstr "``sha512``;"

#: ../../using/configure.rst:1066
msgid "``sha3`` (with shake);"
msgstr "``sha3`` (shake を含む);"

#: ../../using/configure.rst:1067
msgid "``blake2``."
msgstr "``blake2``."

#: ../../using/configure.rst:1073
msgid "Override the OpenSSL default cipher suites string:"
msgstr "OpenSSL のデフォルトの暗号スイート文字列をオーバーライドします:"

#: ../../using/configure.rst:1075
msgid "``python`` (default): use Python's preferred selection;"
msgstr "``python`` (デフォルト): Python が推奨する選択を使用します;"

#: ../../using/configure.rst:1076
