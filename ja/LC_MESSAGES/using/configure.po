msgstr ""
"デフォルト: ``$(PY_CFLAGS) $(PY_CFLAGS_NODIST) $(PY_CPPFLAGS) $"
"(CFLAGSFORSHARED)``。"

#: ../../using/configure.rst:1564
msgid "Default: ``$(PY_STDMODULE_CFLAGS) -DPy_BUILD_CORE``."
msgstr "デフォルト: ``$(PY_STDMODULE_CFLAGS) -DPy_BUILD_CORE``。"

#: ../../using/configure.rst:1570
