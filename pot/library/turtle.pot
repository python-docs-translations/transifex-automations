#: ../../library/turtle.rst:433
msgid "90 - east"
msgstr ""

#: ../../library/turtle.rst:434
msgid "180 - west"
msgstr ""

#: ../../library/turtle.rst:434
msgid "180 - south"
msgstr ""

#: ../../library/turtle.rst:435
msgid "270 - south"
msgstr ""

#: ../../library/turtle.rst:435
msgid "270 - west"
msgstr ""

#: ../../library/turtle.rst:438
msgid ""
">>> turtle.setheading(90)\n"
">>> turtle.heading()\n"
"90.0"
msgstr ""

#: ../../library/turtle.rst:448
msgid ""
"Move the turtle to the origin, coordinates (0,0). The turtle's heading is "
"set to its start orientation, which depends on the turtle mode, see :func:"
"`mode`."
msgstr ""

#: ../../library/turtle.rst:459
msgid ""
">>> turtle.heading()\n"
"90.0\n"
">>> turtle.position()\n"
"(0.00,-10.00)\n"
">>> turtle.home()\n"
">>> turtle.position()\n"
"(0.00,0.00)\n"
">>> turtle.heading()\n"
"0.0"
